set nocompatible
set number
set relativenumber
set mouse=a
set hidden
set noswapfile
set undofile

set tabstop=4
set shiftwidth=4
set expandtab
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set showcmd
set wildmenu

set backspace=indent,eol,start
set scrolloff=5
set splitright
set splitbelow

syntax enable
set background=dark
set termguicolors
set showmatch
set list
set listchars=tab:⮚\ ,trail:·

set noundofile
set noswapfile
set nobackup

" netrw
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_altv = 1
let g:netrw_winsize = 30
let g:netrw_preview = 1
